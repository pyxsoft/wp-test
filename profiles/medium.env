# wp-test profile: medium
#
# A media-heavy editorial site: the shape most real WordPress hosting actually
# serves. This is the default profile for cache, WebP, Early Hints and
# bandwidth comparisons — large originals, many thumbnails, galleries on the
# page, and enough posts that the database stops fitting in a trivial cache.
#
# Target on-disk size: ~500 MB

PROFILE_NAME=medium
TARGET_SIZE_MB=500

# Content volume
POSTS=400
PAGES=25
CATEGORIES=18
TAGS=120
COMMENTS_MAX=12
MENU_ITEMS=10

# Media
#
# Measured on a build of this profile: an original averages 1.75 MB, and
# WordPress turns each one into ~7.6 files totalling ~3.4 MB on disk once every
# registered thumbnail size is rendered. So the library costs roughly
# 3.4 MB x IMAGES — raise IMAGES to make the fixture bigger, and expect about
# 1.7 s per image of build time.
IMAGES=145
IMAGE_MIN_WIDTH=2400
IMAGE_MAX_WIDTH=3600
JPEG_QUALITY=88
IMAGE_DETAIL=14
THUMBNAILS=full

# Post body size, in blocks
BODY_MIN_BLOCKS=12
BODY_MAX_BLOCKS=30
IMAGES_PER_POST_MAX=8

# WooCommerce
WOO_ENABLED=0
WOO_PRODUCTS=0
WOO_ORDERS=0

# Share of the library stored as PNG (%). Real WordPress libraries are mostly
# JPEG with a minority of screenshots and diagrams as PNG. Both formats matter
# for WebP benchmarks: engines apply a size threshold that PNG clears far more
# easily than already-compressed JPEG, so a fixture needs both to tell you
# which of the two paths actually works.
PNG_SHARE=22
