# wp-test profile: small
#
# Smoke tests and quick A/B runs. Builds in a couple of minutes on any box and
# fits comfortably in a shared account. Use it to prove a benchmark harness
# works before spending an hour on `heavy`.
#
# Target on-disk size: ~50 MB

PROFILE_NAME=small
TARGET_SIZE_MB=50

# Content volume
POSTS=25
PAGES=6
CATEGORIES=6
TAGS=20
COMMENTS_MAX=4
MENU_ITEMS=6

# Media. IMAGES is the count of originals; WordPress multiplies that by the
# registered thumbnail sizes, which is where most of the disk actually goes.
IMAGES=45
IMAGE_MIN_WIDTH=1400
IMAGE_MAX_WIDTH=2000
JPEG_QUALITY=82
IMAGE_DETAIL=12
THUMBNAILS=full

# Post body size, in blocks
BODY_MIN_BLOCKS=6
BODY_MAX_BLOCKS=14
IMAGES_PER_POST_MAX=3

# WooCommerce
WOO_ENABLED=0
WOO_PRODUCTS=0
WOO_ORDERS=0

# Share of the library stored as PNG (%). Real WordPress libraries are mostly
# JPEG with a minority of screenshots and diagrams as PNG. Both formats matter
# for WebP benchmarks: engines apply a size threshold that PNG clears far more
# easily than already-compressed JPEG, so a fixture needs both to tell you
# which of the two paths actually works.
PNG_SHARE=20
