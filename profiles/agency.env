# wp-test profile: agency
#
# The PHP-heavy profile. Where `medium` and `heavy` load the disk and the
# database, this one loads the interpreter: a page builder that reconstructs
# every page from a JSON document, plus the plugin pack that a real agency site
# accumulates (SEO, forms, redirects, backups, builder add-ons), each hooking
# into every request.
#
# Use it when the question is "how fast is PHP here" — PHP version, opcache,
# FPM pool sizing, per-account CPU limits. Use `medium` when the question is
# about static delivery, and `heavy` when it is about the database.
#
# Deliberately *not* huge on disk: mixing a large media library into this would
# blur the two effects. Keep the variable single.
#
# Measured: 140 MB on disk, 2m18s to build, 30 Elementor pages carrying 2399
# widgets and 1.4 MB of document JSON. A builder page costs ~36% more time and
# 2.6x the HTML of an ordinary post from the same fixture.
#
# Target on-disk size: ~150 MB

PROFILE_NAME=agency
TARGET_SIZE_MB=150

# Content volume — modest on purpose; the cost here is per-request, not per-byte
POSTS=120
PAGES=10
CATEGORIES=10
TAGS=40
COMMENTS_MAX=6
MENU_ITEMS=10

# Media
IMAGES=70
IMAGE_MIN_WIDTH=1600
IMAGE_MAX_WIDTH=2600
JPEG_QUALITY=85
IMAGE_DETAIL=13
THUMBNAILS=full
PNG_SHARE=25

# Post body size, in blocks
BODY_MIN_BLOCKS=8
BODY_MAX_BLOCKS=20
IMAGES_PER_POST_MAX=4

# WooCommerce — off: keep this profile about PHP render cost alone
WOO_ENABLED=0
WOO_PRODUCTS=0
WOO_ORDERS=0

# Elementor pages. Sections are the unit that matters: each one becomes a
# nested tree of columns and widgets that the front end rebuilds from JSON on
# every uncached request. 30 pages at 6-18 sections is a small-to-mid agency
# site; the first page created becomes the front page.
ELEMENTOR_PAGES=30
ELEMENTOR_MIN_SECTIONS=6
ELEMENTOR_MAX_SECTIONS=18

# Plugin pack installed before content generation (see agency.plugins)
PLUGIN_PACK=agency.plugins
