# wp-test profile: heavy
#
# The stress case: a large media library plus a WooCommerce catalogue. Shop,
# cart and checkout pages are deliberately uncacheable, so this profile is the
# one that tells you what PHP-FPM and MySQL really do under load — full-page
# cache hit ratios stop hiding the origin.
#
# Expect a long build (roughly 40-90 minutes depending on cores and disk) and
# plan for the thumbnail pass, which is the slowest part by far. Build it on
# the machine under test; do not try to move it over the network.
#
# Target on-disk size: ~3 GB

PROFILE_NAME=heavy
TARGET_SIZE_MB=3400

# Content volume
POSTS=1500
PAGES=60
CATEGORIES=40
TAGS=400
COMMENTS_MAX=25
MENU_ITEMS=14

# Media
#
# These originals are larger than medium's, so each costs about 6 MB on disk
# once thumbnails are rendered (measured: 3.4 MB per image at medium's 2400-3600
# px, scaled by area for this profile's range). The catalogue reuses this same
# library rather than generating a second one, so 480 originals still give every
# product an image and a three-shot gallery.
IMAGES=480
IMAGE_MIN_WIDTH=3200
IMAGE_MAX_WIDTH=4800
JPEG_QUALITY=90
IMAGE_DETAIL=16
THUMBNAILS=full

# Post body size, in blocks
BODY_MIN_BLOCKS=18
BODY_MAX_BLOCKS=45
IMAGES_PER_POST_MAX=12

# WooCommerce
WOO_ENABLED=1
WOO_PRODUCTS=5000
WOO_ORDERS=2000

# Share of the library stored as PNG (%). Real WordPress libraries are mostly
# JPEG with a minority of screenshots and diagrams as PNG. Both formats matter
# for WebP benchmarks: engines apply a size threshold that PNG clears far more
# easily than already-compressed JPEG, so a fixture needs both to tell you
# which of the two paths actually works.
PNG_SHARE=18
